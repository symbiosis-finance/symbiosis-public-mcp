# Symbiosis MCP Server — Environment Variables
# Copy this file to .env and uncomment/edit the values you need.

# --- Required for swap execution ---

# EVM private key (without 0x prefix). Enables sign_transaction,
# sign_and_broadcast, and get_swap_calldata_and_sign_and_broadcast tools.
# Without this, the server works in quote-only mode.
#PRIVATE_KEY=

# --- Transport ---

# Server transport mode: "stdio" (default, for CLI integrations) or "http"
#MCP_TRANSPORT=stdio

# HTTP server settings (only used when MCP_TRANSPORT=http)
#PORT=3000
#HOST=0.0.0.0

# --- Broadcasting ---

# How many RPCs to blast simultaneously when broadcasting a signed transaction.
# Higher = faster propagation but more parallel requests. Default: 10.
# Every 1 second without success, the next batch of this size is sent.
#BROADCAST_BATCH_SIZE=10
